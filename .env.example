# === MySQL ===
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=profit_user
MYSQL_PASSWORD=changeme

# === Spring Datasource ===
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/profit_logic?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=profit_user
SPRING_DATASOURCE_PASSWORD=changeme

# === JWT (최소 256비트 / 32바이트 이상) ===
JWT_SECRET=your-production-jwt-secret-must-be-at-least-32-bytes-long
JWT_EXPIRATION=86400000

# === CORS ===
CORS_ALLOWED_ORIGINS=https://your-domain.com

# === Server IP (docker-compose.prod.yml용) ===
SERVER_IP=your-server-ip
