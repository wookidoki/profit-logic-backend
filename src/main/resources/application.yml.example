spring:
  application:
    name: profit-logic-backend

  profiles:
    active: local
    include: private

  # Datasource — 환경변수로 주입 (로컬은 application-local.yml에서 H2로 오버라이드)
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/profit_logic?serverTimezone=Asia/Seoul&characterEncoding=UTF-8}
    username: ${SPRING_DATASOURCE_USERNAME:}
    password: ${SPRING_DATASOURCE_PASSWORD:}
    driver-class-name: com.mysql.cj.jdbc.Driver

  # JPA
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect

  # Jackson
  jackson:
    property-naming-strategy: SNAKE_CASE
    time-zone: Asia/Seoul

server:
  port: 8080
  servlet:
    context-path: /api

# Logging
logging:
  level:
    root: INFO
    com.wookidoki.profitlogic: DEBUG
    org.hibernate.SQL: DEBUG

# JWT — 환경변수로 주입 (프로덕션에서는 반드시 강력한 시크릿 사용)
jwt:
  secret: ${JWT_SECRET:bG9jYWwtZGV2LW9ubHktand0LXNlY3JldC1rZXktMjU2Yml0cy1taW5pbXVtLXBhZGRpbmc=}
  expiration: ${JWT_EXPIRATION:86400000}

# CORS
cors:
  allowed-origins: http://localhost:5173
  allowed-methods: GET,POST,PUT,DELETE,PATCH,OPTIONS
  allowed-headers: "*"
  allow-credentials: true
